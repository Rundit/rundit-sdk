      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "ai-manifest.json",
    "openapi.json",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  }
}
