{
  "name": "@rundit-sdk/embed",
  "version": "0.3.3",
  "description": "Public Rundit embed SDK for iframe and embedded module consumers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rundit/rundit-sdk.git",
    "directory": "packages/embed"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
